# Explicitly choose demo for offline deterministic scenarios or live only after
# all source-specific credentials, clients, and parsers have been configured.
DATA_MODE=demo

# ECMWF Open Data / licensed access
ECMWF_API_KEY=
ECMWF_API_URL=https://data.ecmwf.int/forecasts/

# Copernicus Climate Data Store (ERA5)
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# ISRO MOSDAC (INSAT-3D/3DR)
MOSDAC_API_URL=
MOSDAC_API_KEY=

# NASA Earthdata / GES DISC (GPM IMERG)
NASA_USERNAME=
NASA_PASSWORD=# Backend
DB_PATH=./backend/data/app.db

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
